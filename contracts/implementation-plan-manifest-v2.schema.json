{
  "type": "object",
  "required": [
    "schema_version",
    "ticket_id",
    "repository",
    "plan_path",
    "plan_sha256",
    "base_sha",
    "ticket_revision",
    "epic",
    "hard_dependencies",
    "predecessor_outputs",
    "soft_dependencies",
    "rows",
    "portfolio",
    "ownership",
    "compatibility",
    "staleness",
    "just_in_time_revalidation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "implementation-plan-manifest/v2"
    },
    "ticket_id": {
      "type": "string",
      "title": "Ticket identity",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "repository": {
      "type": "string",
      "title": "Repository identity",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "plan_path": {
      "type": "string",
      "title": "Portable repository-relative POSIX path",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*%)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9._-])?$"
    },
    "plan_sha256": {
      "type": "string",
      "title": "Lowercase SHA-256 digest",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_sha": {
      "type": "string",
      "title": "Immutable Git revision",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "ticket_revision": {
      "type": "string",
      "title": "Immutable Git revision",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "epic": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "standalone"
            },
            {
              "type": "string",
              "const": "member"
            },
            {
              "type": "string",
              "const": "umbrella"
            }
          ],
          "title": "Epic or umbrella role"
        },
        "epic_id": {
          "type": "string",
          "title": "Epic or umbrella identity",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "title": {
          "type": "string",
          "title": "Epic or umbrella title",
          "minLength": 1,
          "maxLength": 256
        },
        "member_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      },
      "additionalProperties": false
    },
    "hard_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticket_id",
          "reason",
          "required_outputs",
          "requirement_ids"
        ],
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket identity",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
          },
          "reason": {
            "type": "string",
            "title": "Explicit hard dependency reason",
            "minLength": 1,
            "maxLength": 2048
          },
          "required_outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Required predecessor output",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            },
            "minItems": 0,
            "maxItems": 32
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Dependent requirement identity",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            },
            "minItems": 0,
            "maxItems": 32
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "predecessor_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticket_id",
          "output_id",
          "contract"
        ],
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket identity",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
          },
          "output_id": {
            "type": "string",
            "title": "Expected predecessor output identity",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "contract": {
            "type": "string",
            "title": "Expected predecessor contract identity",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "expected_digest": {
            "type": "string",
            "title": "Lowercase SHA-256 digest",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "expected_revision": {
            "type": "string",
            "title": "Immutable Git revision",
            "minLength": 40,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "soft_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticket_id",
          "evidence",
          "confidence"
        ],
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket identity",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "source",
                "summary"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "title": "Soft dependency evidence kind",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
                },
                "source": {
                  "type": "string",
                  "title": "Soft dependency evidence source",
                  "minLength": 1,
                  "maxLength": 512
                },
                "summary": {
                  "type": "string",
                  "title": "Soft dependency evidence summary",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "const": "low"
              },
              {
                "type": "string",
                "const": "medium"
              },
              {
                "type": "string",
                "const": "high"
              }
            ],
            "title": "Soft dependency confidence"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "acceptance_class",
          "requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "title": "Acceptance requirement identity",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "title": {
            "type": "string",
            "title": "Acceptance requirement title",
            "minLength": 1,
            "maxLength": 256
          },
          "acceptance_class": {
            "anyOf": [
              {
                "type": "string",
                "const": "ordinary"
              },
              {
                "type": "string",
                "const": "authority"
              },
              {
                "type": "string",
                "const": "requirement"
              },
              {
                "type": "string",
                "const": "resource-bounded"
              },
              {
                "type": "string",
                "const": "concurrency"
              },
              {
                "type": "string",
                "const": "evidence"
              },
              {
                "type": "string",
                "const": "benchmark"
              }
            ],
            "title": "Acceptance class"
          },
          "requirement": {
            "type": "string",
            "title": "Acceptance requirement",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "portfolio": {
      "type": "object",
      "required": [
        "planning_effort",
        "implementation_size",
        "requirement_readiness",
        "information_gain",
        "downstream_unblock_set",
        "affected_contracts",
        "affected_packages",
        "conflict_surface",
        "staleness_horizon_days",
        "risk_reduction_value",
        "unresolved_human_decisions"
      ],
      "properties": {
        "planning_effort": {
          "anyOf": [
            {
              "type": "string",
              "const": "small"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "large"
            },
            {
              "type": "string",
              "const": "very_large"
            }
          ],
          "title": "Planning effort"
        },
        "implementation_size": {
          "anyOf": [
            {
              "type": "string",
              "const": "small"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "large"
            },
            {
              "type": "string",
              "const": "very_large"
            }
          ],
          "title": "Implementation size"
        },
        "requirement_readiness": {
          "anyOf": [
            {
              "type": "string",
              "const": "not_ready"
            },
            {
              "type": "string",
              "const": "partially_ready"
            },
            {
              "type": "string",
              "const": "ready"
            }
          ],
          "title": "Requirement readiness"
        },
        "information_gain": {
          "anyOf": [
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            }
          ],
          "title": "Bounded qualitative scale"
        },
        "downstream_unblock_set": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Ticket identity",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "affected_contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Affected contract identity",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "affected_packages": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Affected package identity",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "conflict_surface": {
          "anyOf": [
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            }
          ],
          "title": "Bounded qualitative scale"
        },
        "staleness_horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "risk_reduction_value": {
          "anyOf": [
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            }
          ],
          "title": "Bounded qualitative scale"
        },
        "unresolved_human_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "blocking"
            ],
            "properties": {
              "id": {
                "type": "string",
                "title": "Human decision identity",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
              },
              "question": {
                "type": "string",
                "title": "Unresolved human decision",
                "minLength": 1,
                "maxLength": 1024
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "required": [
        "files",
        "symbols",
        "contracts"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Portable repository-relative POSIX path",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*%)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9._-])?$"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Owned symbol identity",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Owned contract identity",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "assumptions",
        "preserves_v1_readability",
        "silently_upgrades_v1"
      ],
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Compatibility assumption",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 32
        },
        "preserves_v1_readability": {
          "type": "boolean"
        },
        "silently_upgrades_v1": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "staleness": {
      "type": "object",
      "required": [
        "triggers",
        "descendant_base_campaign_drift_is_not_plan_staleness"
      ],
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "input",
              "action"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "plan_changed"
                  },
                  {
                    "type": "string",
                    "const": "ticket_changed"
                  },
                  {
                    "type": "string",
                    "const": "base_revision_changed"
                  },
                  {
                    "type": "string",
                    "const": "predecessor_output_changed"
                  },
                  {
                    "type": "string",
                    "const": "contract_changed"
                  },
                  {
                    "type": "string",
                    "const": "requirement_changed"
                  },
                  {
                    "type": "string",
                    "const": "approval_expired"
                  }
                ],
                "title": "Staleness trigger kind"
              },
              "input": {
                "type": "string",
                "title": "Staleness trigger input",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
              },
              "action": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "manual_refresh"
                  },
                  {
                    "type": "string",
                    "const": "revalidate"
                  },
                  {
                    "type": "string",
                    "const": "renew_approval"
                  }
                ],
                "title": "Staleness response"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "descendant_base_campaign_drift_is_not_plan_staleness": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "just_in_time_revalidation": {
      "type": "object",
      "required": [
        "inputs",
        "required_before"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "name",
              "expected"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "repository_revision"
                  },
                  {
                    "type": "string",
                    "const": "ticket_revision"
                  },
                  {
                    "type": "string",
                    "const": "plan_digest"
                  },
                  {
                    "type": "string",
                    "const": "predecessor_output"
                  },
                  {
                    "type": "string",
                    "const": "contract_digest"
                  }
                ],
                "title": "Just-in-time revalidation input kind"
              },
              "name": {
                "type": "string",
                "title": "Just-in-time revalidation input name",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
              },
              "expected": {
                "type": "string",
                "title": "Expected revalidation value",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "required_before": {
          "anyOf": [
            {
              "type": "string",
              "const": "implementation"
            },
            {
              "type": "string",
              "const": "validation"
            },
            {
              "type": "string",
              "const": "publication"
            }
          ],
          "title": "Revalidation phase"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-sampler.dev/contracts/implementation-plan-manifest/v2",
  "title": "Implementation Plan Manifest v2",
  "additionalProperties": false
}
