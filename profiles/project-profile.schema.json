{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Sampler project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "workItem", "repository", "delivery", "verification", "governance"],
  "properties": {
    "projectId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "workItem": {
      "type": "object", "additionalProperties": false,
      "required": ["idPattern"],
      "properties": {"idPattern": {"type": "string", "minLength": 1}}
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["source"],
      "properties": {"source": {"type": "string", "minLength": 1}}
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["remote", "baseBranch", "worktreeRoot", "branchPrefix", "suffixLength"],
      "properties": {
        "remote": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "baseBranch": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!-).+"},
        "worktreeRoot": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+"},
        "branchPrefix": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "suffixLength": {"type": "integer", "minimum": 4, "maximum": 12},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspaceRoot", "quarantineRoot", "remotePolicy", "quarantineRetentionSeconds", "limits"],
          "properties": {
            "workspaceRoot": {"type": "string", "minLength": 1, "maxLength": 240},
            "quarantineRoot": {"type": "string", "minLength": 1, "maxLength": 240},
            "remotePolicy": {"type": "string", "enum": ["none"]},
            "quarantineRetentionSeconds": {"type": "integer", "minimum": 0, "maximum": 31536000},
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxWorkspaces", "maxWorkspaceBytes", "maxQuarantineBytes", "maxUntrackedEntries", "maxUntrackedBytes"],
              "properties": {
                "maxWorkspaces": {"type": "integer", "minimum": 1, "maximum": 256},
                "maxWorkspaceBytes": {"type": "integer", "minimum": 1048576, "maximum": 8589934592},
                "maxQuarantineBytes": {"type": "integer", "minimum": 1048576, "maximum": 8589934592},
                "maxUntrackedEntries": {"type": "integer", "minimum": 1, "maximum": 100000},
                "maxUntrackedBytes": {"type": "integer", "minimum": 0, "maximum": 2147483648}
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["commands"],
      "properties": {"commands": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "args"], "properties": {"command": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}}}}}
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredChecks", "paths"],
      "properties": {
        "requiredChecks": {"type": "array", "items": {"type": "string"}},
        "paths": {"type": "object", "required": ["evidence", "specification"], "properties": {"evidence": {"type": "string"}, "specification": {"type": "string"}}}
      }
    }
  }
}
