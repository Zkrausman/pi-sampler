{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Sampler project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "workItem", "repository", "delivery", "verification", "governance"],
  "properties": {
    "projectId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "workItem": {
      "type": "object", "additionalProperties": false,
      "required": ["idPattern"],
      "properties": {"idPattern": {"type": "string", "minLength": 1}}
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["source"],
      "properties": {"source": {"type": "string", "minLength": 1}}
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["remote", "baseBranch", "worktreeRoot", "branchPrefix", "suffixLength", "review"],
      "properties": {
        "remote": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "baseBranch": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!-).+"},
        "worktreeRoot": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+"},
        "branchPrefix": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "suffixLength": {"type": "integer", "minimum": 4, "maximum": 12},
        "review": {
          "type": "object", "additionalProperties": false,
          "required": ["workspaceRoot", "quarantineRoot", "remotePolicy", "quarantineRetentionSeconds", "limits"],
          "properties": {
            "workspaceRoot": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+"},
            "quarantineRoot": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+"},
            "remotePolicy": {"const": "none"},
            "quarantineRetentionSeconds": {"type": "integer", "minimum": 0, "maximum": 31536000},
            "limits": {
              "type": "object", "additionalProperties": false,
              "required": ["maxWorkspaces", "maxWorkspaceBytes", "maxQuarantineBytes", "maxUntrackedEntries", "maxUntrackedBytes"],
              "properties": {
                "maxWorkspaces": {"type": "integer", "minimum": 1, "maximum": 256},
                "maxWorkspaceBytes": {"type": "integer", "minimum": 1048576, "maximum": 9007199254740991},
                "maxQuarantineBytes": {"type": "integer", "minimum": 1048576, "maximum": 9007199254740991},
                "maxUntrackedEntries": {"type": "integer", "minimum": 1, "maximum": 100000},
                "maxUntrackedBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["commands"],
      "properties": {"commands": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "args"], "properties": {"command": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}}}}}
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["classes", "requireCompleteMatrix", "explicitMergeAuthority"],
      "properties": {
        "classes": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "verifier", "environment"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
              "kind": {"type": "string", "enum": ["ordinary", "benchmark", "evidence", "requirement"]},
              "verifier": {"type": "string", "minLength": 1, "maxLength": 200},
              "environment": {"type": "string", "enum": ["local", "ci", "review", "external"]},
              "eventCount": {"type": "integer", "minimum": 1, "maximum": 10000000},
              "command": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 256}}
            }
          }
        },
        "requireCompleteMatrix": {"type": "boolean"},
        "explicitMergeAuthority": {
          "type": "object", "additionalProperties": false,
          "required": ["blockedByDefault", "userOnly", "unlockPhrase"],
          "properties": {
            "blockedByDefault": {"const": true},
            "userOnly": {"const": true},
            "unlockPhrase": {"const": "Merge PR #N"}
          }
        }
      }
    },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["workload", "localEventCount", "ciEventCount", "warmupEvents", "repetitions", "timeoutMs", "slopeEstimator"],
      "properties": {
        "workload": {"const": "lesson-registry-rebuild"},
        "localEventCount": {"const": 10000000},
        "ciEventCount": {"type": "integer", "minimum": 1, "maximum": 9999999},
        "warmupEvents": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 32},
        "timeoutMs": {"type": "integer", "minimum": 1000, "maximum": 1800000},
        "slopeEstimator": {"const": "theil-sen"},
        "thresholds": {"type": ["object", "null"]}
      }
    },
    "waiver": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "trustedConfigRequired", "replayStateRequired", "maxAgeSeconds", "maxFutureSkewSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "trustedConfigRequired": {"const": true},
        "replayStateRequired": {"const": true},
        "maxAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "maxFutureSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredChecks", "paths"],
      "properties": {
        "requiredChecks": {"type": "array", "items": {"type": "string"}},
        "paths": {"type": "object", "required": ["evidence", "specification"], "properties": {"evidence": {"type": "string"}, "specification": {"type": "string"}}}
      }
    }
  }
}
