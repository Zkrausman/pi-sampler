{
  "projectId": "pi-sampler",
  "workItem": { "idPattern": "^AIDEV-[0-9]+$" },
  "repository": { "source": "Zkrausman/pi-sampler" },
  "delivery": {
    "remote": "origin",
    "baseBranch": "main",
    "worktreeRoot": "../ai-workspaces",
    "branchPrefix": "zkrausman",
    "suffixLength": 6,
    "review": {
      "workspaceRoot": "../ai-workspaces/review",
      "quarantineRoot": "../ai-workspaces/review-quarantine",
      "remotePolicy": "none",
      "quarantineRetentionSeconds": 86400,
      "limits": {
        "maxWorkspaces": 16,
        "maxWorkspaceBytes": 2147483648,
        "maxQuarantineBytes": 2147483648,
        "maxUntrackedEntries": 512,
        "maxUntrackedBytes": 536870912
      }
    }
  },
  "verification": {
    "commands": [
      { "command": "npm", "args": ["test"] }
    ]
  },
  "acceptance": {
    "classes": [
      { "id": "ordinary", "kind": "ordinary", "verifier": "npm-test", "environment": "local", "command": ["npm", "test"] },
      { "id": "benchmark-local-10m", "kind": "benchmark", "verifier": "lesson-registry-benchmark", "environment": "local", "eventCount": 10000000, "command": ["npm", "run", "benchmark:lesson-registry"] },
      { "id": "benchmark-ci-regression", "kind": "benchmark", "verifier": "lesson-registry-benchmark", "environment": "ci", "eventCount": 10000, "command": ["npm", "run", "benchmark:lesson-registry:ci"] },
      { "id": "authority", "kind": "ordinary", "verifier": "delivery-acceptance-tests", "environment": "local", "command": ["npm", "test"] },
      { "id": "requirement", "kind": "requirement", "verifier": "wiki-requirement", "environment": "local" },
      { "id": "resource-bounded", "kind": "ordinary", "verifier": "delivery-evidence-validator", "environment": "local" },
      { "id": "concurrency", "kind": "ordinary", "verifier": "delivery-evidence-validator", "environment": "local" },
      { "id": "external-waiver", "kind": "evidence", "verifier": "delivery-waiver", "environment": "external" }
    ],
    "requireCompleteMatrix": true,
    "explicitMergeAuthority": {
      "blockedByDefault": true,
      "userOnly": true,
      "unlockPhrase": "Merge PR #N"
    }
  },
  "benchmark": {
    "workload": "lesson-registry-rebuild",
    "localEventCount": 10000000,
    "ciEventCount": 10000,
    "warmupEvents": 1000,
    "repetitions": 3,
    "timeoutMs": 900000,
    "slopeEstimator": "theil-sen",
    "thresholds": null
  },
  "waiver": {
    "enabled": true,
    "trustedConfigRequired": true,
    "replayStateRequired": true,
    "maxAgeSeconds": 2592000,
    "maxFutureSkewSeconds": 300
  },
  "governance": {
    "requiredChecks": ["test"],
    "paths": { 
      "evidence": "docs/evidence", 
      "specification": "docs/techPlans" 
    }
  }
}
