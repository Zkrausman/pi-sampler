{
  "name": "pi-sampler",
  "private": true,
  "version": "0.1.0",
  "description": "Source monorepo for reusable Pi extension packages.",
  "private": true,
  "type": "module",
  "workspaces": ["extensions/*"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:legacy": "node --test extensions/delivery-controller/src/*.test.mjs extensions/wiki-delivery/src/*.test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
