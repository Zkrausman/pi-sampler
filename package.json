{
  "name": "pi-sampler",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable Pi extensions and project-agnostic AI delivery tooling.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "test:legacy": "node --test extensions/delivery-controller/src/*.test.mjs extensions/wiki-delivery/src/*.test.mjs"
  },
  "engines": { "node": ">=22" },
  "pi": {
    "extensions": [
      "./extensions/delivery-controller/src/index.ts",
      "./extensions/output-optimizer/src/index.ts",
      "./extensions/wiki-delivery/src/index.ts"
    ]
  }
}
