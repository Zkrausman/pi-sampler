{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-sampler.dev/schemas/scoped-review-packet-v3.json",
  "title": "Pi Sampler scoped review packet v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "base",
    "head",
    "changedFiles",
    "diffStat",
    "patches",
    "incomplete",
    "omittedHunks",
    "byteTruncatedHunks",
    "immutableMaterial"
  ],
  "properties": {
    "format": {
      "const": "pi-sampler.scoped-review-packet.v3"
    },
    "base": {
      "$ref": "#/$defs/commitSha"
    },
    "head": {
      "$ref": "#/$defs/commitSha"
    },
    "changedFiles": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/changedFile"
      }
    },
    "diffStat": {
      "type": "string",
      "maxLength": 32768
    },
    "patches": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "incomplete": {
      "const": false
    },
    "omittedHunks": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "byteTruncatedHunks": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "immutableMaterial": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "validationEvidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$",
      "minLength": 40,
      "maxLength": 64
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "enum": [
            "A",
            "D",
            "M"
          ]
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hunks"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "hunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/hunk"
          }
        }
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "logicalLines"
      ],
      "properties": {
        "header": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "logicalLines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/logicalLine"
          }
        }
      }
    },
    "logicalLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    }
  }
}
