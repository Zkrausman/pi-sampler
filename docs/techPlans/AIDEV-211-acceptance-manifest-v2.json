  "rows": [
    {
      "id": "A211-T01",
      "title": "Sibling worktree writes fail before mutation",
      "acceptance_class": "ordinary",
      "requirement": "Tests prove attempted writes from one managed worktree into a sibling Dev/Plan/Review worktree fail before filesystem mutation."
    },
    {
      "id": "A211-T02",
      "title": "Review source is read-only",
      "acceptance_class": "ordinary",
      "requirement": "Tests prove review source writes fail while exact external review-evidence writes succeed."
    },
    {
      "id": "A211-T03",
      "title": "Canonical wiki isolation",
      "acceptance_class": "ordinary",
      "requirement": "Tests prove wiki calls from managed worktrees modify only the canonical vault and leave every managed workspace byte-identical."
    },
    {
      "id": "A211-T04",
      "title": "Stale resume rejection or rebind",
      "acceptance_class": "authority",
      "requirement": "Tests prove stale/quarantined/moved session and subagent resume bindings fail closed or complete an authenticated explicit rebind; no old cwd is used."
    },
    {
      "id": "A211-T05",
      "title": "Cross-platform path and race defense",
      "acceptance_class": "ordinary",
      "requirement": "Tests cover Windows junction/UNC/case/device-path and POSIX symlink/path-traversal escape attempts plus TOCTOU cases."
    },
    {
      "id": "A211-T06",
      "title": "Descendant process confinement",
      "acceptance_class": "ordinary",
      "requirement": "Spawned shell/process attempts cannot escape allowed roots."
    },
    {
      "id": "A211-T07",
      "title": "Bounded privacy-safe denials",
      "acceptance_class": "authority",
      "requirement": "Denial diagnostics are bounded, deterministic, and privacy-safe."
    },
    {
      "id": "A211-T08",
      "title": "Existing delivery authorities preserved",
      "acceptance_class": "authority",
      "requirement": "Existing lease, packet-v3, receipt-v1, marker-v3, DCO, protected CI, independent review, and human-only merge authority remain unchanged."
    },
    {
      "id": "A211-T09",
      "title": "Fresh adversarial review",
      "acceptance_class": "authority",
      "requirement": "A fresh independent adversarial review demonstrates there is no write path from one active worktree into another."
    }
