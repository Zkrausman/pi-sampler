{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project.local/schemas/code-review-finding.schema.json",
  "title": "Project Code Review Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "rule_id",
    "check",
    "severity",
    "evidence",
    "root_cause",
    "required_correction",
    "acceptance_criteria",
    "classification",
    "disposition",
    "rerun_result",
    "regression_fixture_id"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{2,127}"
    },
    "rule_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{2,127}"
    },
    "check": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "evidence": { "type": "string", "minLength": 1 },
    "root_cause": { "type": "string", "minLength": 1 },
    "required_correction": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "string", "minLength": 1 },
    "classification": {
      "enum": ["introduced", "pre-existing", "environment-only", "resolved"]
    },
    "disposition": {
      "enum": ["confirmed", "false-positive", "false-negative", "environment-only"]
    },
    "rerun_result": { "type": "string", "minLength": 1 },
    "regression_fixture_id": {
      "type": ["string", "null"],
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{2,127}"
    }
  }
}
