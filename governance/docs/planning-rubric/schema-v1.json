{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project planning quality rubric v1",
  "description": "Machine-readable planning-quality rubric for create-ticket and create-epic. pkg/planningrubric is authoritative for path and cross-field invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "ticket_id", "work_class", "repository_research", "actor_authority", "async_agentic", "credentials_integrations", "acceptance_criteria", "dependency_graph", "discovery_spike", "planning_report"],
  "properties": {
    "schema_version": { "const": "planning-rubric/v1" },
    "kind": { "enum": ["ticket", "epic"] },
    "ticket_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
    "work_class": { "enum": ["project-runtime", "development-process"] },
    "repository_research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cited_paths", "overlap_search", "source_of_truth_refs"],
      "properties": {
        "cited_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "overlap_search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queries", "existing_issues_checked", "docs_checked"],
          "properties": {
            "queries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "existing_issues_checked": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "docs_checked": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "source_of_truth_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "actor_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actors", "no_self_approval", "mutation_bounds"],
      "properties": {
        "actors": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "authority", "trust_boundary"],
            "properties": {
              "role": { "enum": ["controller", "implementer", "reviewer"] },
              "authority": { "type": "string", "minLength": 1 },
              "trust_boundary": { "type": "string", "minLength": 1 }
            }
          }
        },
        "no_self_approval": { "const": true },
        "mutation_bounds": { "type": "string", "minLength": 1 }
      }
    },
    "async_agentic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_async", "state_machine", "idempotency", "failure_retry_cancellation", "evidence", "observability", "rollback"],
      "properties": {
        "is_async": { "type": "boolean" },
        "state_machine": { "type": "string" },
        "idempotency": { "type": "string" },
        "failure_retry_cancellation": { "type": "string" },
        "evidence": { "type": "string" },
        "observability": { "type": "string" },
        "rollback": { "type": "string" }
      }
    },
    "credentials_integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_integration", "least_privilege", "secret_redaction", "merge_completion_policy"],
      "properties": {
        "requires_integration": { "type": "boolean" },
        "least_privilege": { "type": "string" },
        "secret_redaction": { "type": "string" },
        "merge_completion_policy": { "type": "string" }
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavioral_tests", "negative_cases", "verification_commands", "completion_evidence", "non_go_verification"],
      "properties": {
        "behavioral_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "negative_cases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "verification_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "completion_evidence": { "type": "string", "minLength": 1 },
        "non_go_verification": { "type": "string", "minLength": 1 }
      }
    },
    "dependency_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "foundation_before_automation", "rationale"],
      "properties": {
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "foundation_before_automation": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "discovery_spike": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_external_capability", "spike_ticket", "assumed_apis"],
      "properties": {
        "requires_external_capability": { "type": "boolean" },
        "spike_ticket": { "type": "string" },
        "assumed_apis": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "planning_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_outcome", "unresolved_assumptions", "dependency_rationale", "human_escalation_conditions"],
      "properties": {
        "rubric_outcome": { "enum": ["pass", "fail"] },
        "unresolved_assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dependency_rationale": { "type": "string", "minLength": 1 },
        "human_escalation_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
