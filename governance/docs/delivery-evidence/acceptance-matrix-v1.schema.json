{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-sampler.dev/delivery-evidence/acceptance-matrix-v1.schema.json",
  "title": "Delivery acceptance matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticket_id", "repository", "plan_sha256", "manifest_sha256", "base_sha", "head_sha", "pull_request_number", "generated_at", "rows"],
  "properties": {
    "schema_version": {"const": "acceptance-matrix/v1"},
    "ticket_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$", "maxLength": 64},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"},
    "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"},
    "pull_request_number": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "generated_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]{1,9}-T[0-9]{2,4}$", "maxLength": 32},
          "status": {"type": "string", "enum": ["observed", "waived", "blocked"]},
          "observed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["acceptance_class", "verifier", "command", "tool_version", "environment_class", "exit_status", "started_at", "completed_at", "artifacts"],
            "properties": {
              "acceptance_class": {"type": "string", "enum": ["ordinary", "authority", "waiver", "requirement", "benchmark-local-10m", "benchmark-ci-regression", "resource-bounded", "concurrency"]},
              "verifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/ -]{0,199}$"},
              "command": {"type": "string", "minLength": 1, "maxLength": 512},
              "tool_version": {"type": "string", "minLength": 1, "maxLength": 256},
              "environment_class": {"type": "string", "enum": ["local", "ci", "review", "external"]},
              "exit_status": {"type": "integer", "minimum": 0, "maximum": 255},
              "started_at": {"type": "string", "format": "date-time", "maxLength": 64},
              "completed_at": {"type": "string", "format": "date-time", "maxLength": 64},
              "artifacts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "sha256", "bytes"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
                    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                    "bytes": {"type": "integer", "minimum": 0, "maximum": 10485760}
                  }
                }
              },
              "benchmark_evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$", "maxLength": 240},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                }
              }
            }
          },
          "waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "waiver_id", "issuer", "key_id", "repository", "ticket_id", "pull_request", "row_id", "plan_sha256", "rationale", "issue", "nonce", "issued_at", "expires_at", "revocation_ref", "signature"],
            "properties": {
              "schema_version": {"const": "delivery-waiver/v1"},
              "waiver_id": {"type": "string", "pattern": "^waiver-[a-z0-9][a-z0-9-]{0,95}$"},
              "issuer": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/ -]{0,127}$"},
              "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
              "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
              "ticket_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$", "maxLength": 64},
              "pull_request": {
                "type": "object",
                "additionalProperties": false,
                "required": ["number", "base_sha", "head_sha"],
                "properties": {
                  "number": {"type": "integer", "minimum": 1, "maximum": 1000000000},
                  "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"},
                  "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"}
                }
              },
              "row_id": {"type": "string", "pattern": "^A[0-9]{1,9}-T[0-9]{2,4}$", "maxLength": 32},
              "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
              "issue": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$", "maxLength": 64},
              "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
              "issued_at": {"type": "string", "format": "date-time", "maxLength": 64},
              "expires_at": {"type": "string", "format": "date-time", "maxLength": 64},
              "revocation_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
              "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}
            }
          },
          "blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
              "blocked_by": {"type": "string", "maxLength": 256}
            }
          }
        }
      }
    }
  }
}
