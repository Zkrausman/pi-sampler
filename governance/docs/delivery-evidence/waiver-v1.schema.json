{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-sampler.dev/delivery-evidence/waiver-v1.schema.json",
  "title": "Delivery acceptance waiver v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "waiver_id", "issuer", "key_id", "repository", "ticket_id", "pull_request", "row_id", "plan_sha256", "rationale", "issue", "nonce", "issued_at", "expires_at", "revocation_ref", "signature"],
  "properties": {
    "schema_version": {"const": "delivery-waiver/v1"},
    "waiver_id": {"type": "string", "pattern": "^waiver-[a-z0-9][a-z0-9-]{0,95}$"},
    "issuer": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/ -]{0,127}$"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "ticket_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$", "maxLength": 64},
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "base_sha", "head_sha"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"},
        "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"}
      }
    },
    "row_id": {"type": "string", "pattern": "^A[0-9]{1,9}-T[0-9]{2,4}$", "maxLength": 32},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
    "issue": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$", "maxLength": 64},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "issued_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "expires_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "revocation_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}
  }
}
