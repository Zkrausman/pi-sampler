{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-sampler.dev/delivery-evidence/acceptance-matrix-v2.schema.json",
  "title": "Delivery acceptance matrix v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_schema_version",
    "evaluation_scope",
    "repository",
    "ticket_id",
    "ticket_revision",
    "profile_path",
    "profile_sha256",
    "base_sha",
    "head_sha",
    "pull_request_number",
    "plan_path",
    "plan_sha256",
    "manifest_path",
    "manifest_sha256",
    "manifest_contract_path",
    "manifest_contract_sha256",
    "manifest_validator_path",
    "manifest_validator_sha256",
    "matrix_contract_path",
    "matrix_contract_sha256",
    "policy_path",
    "policy_sha256",
    "evidence_root_id",
    "generated_at",
    "rows"
  ],
  "properties": {
    "schema_version": { "const": "acceptance-matrix/v2" },
    "manifest_schema_version": { "const": "implementation-plan-manifest/v2" },
    "evaluation_scope": { "enum": ["plan-publication", "implementation-delivery"] },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$", "maxLength": 256 },
    "ticket_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$", "maxLength": 32 },
    "ticket_revision": { "$ref": "#/$defs/revision" },
    "profile_path": { "const": "profiles/pi-sampler.json" },
    "profile_sha256": { "$ref": "#/$defs/digest" },
    "base_sha": { "$ref": "#/$defs/revision" },
    "head_sha": { "$ref": "#/$defs/revision" },
    "pull_request_number": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "plan_path": { "$ref": "#/$defs/portablePath256", "maxLength": 256 },
    "plan_sha256": { "$ref": "#/$defs/digest" },
    "manifest_path": { "$ref": "#/$defs/portablePath256", "maxLength": 256 },
    "manifest_sha256": { "$ref": "#/$defs/digest" },
    "manifest_contract_path": { "const": "contracts/implementation-plan-manifest-v2.mjs" },
    "manifest_contract_sha256": { "$ref": "#/$defs/digest" },
    "manifest_validator_path": { "const": "scripts/validate-implementation-plan.mjs" },
    "manifest_validator_sha256": { "$ref": "#/$defs/digest" },
    "matrix_contract_path": { "const": "governance/docs/delivery-evidence/acceptance-matrix-v2.schema.json" },
    "matrix_contract_sha256": { "$ref": "#/$defs/digest" },
    "policy_path": { "const": "profiles/pi-sampler.json" },
    "policy_sha256": { "$ref": "#/$defs/digest" },
    "evidence_root_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 1, "maxLength": 128 },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "rows": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$", "minLength": 40, "maxLength": 64 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "minLength": 24, "maxLength": 24 },
    "portablePath": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9._/+,-])(?!/)(?![A-Za-z]:)(?!.*//)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/\\\\]*)?(?:/|$))[A-Za-z0-9][A-Za-z0-9._+,-]*(?:/[A-Za-z0-9][A-Za-z0-9._+,-]*)*$",
      "minLength": 1,
      "maxLength": 240
    },
    "artifactPath": { "allOf": [
      { "$ref": "#/$defs/portablePath" },
      { "type": "string", "pattern": "^(?![^/]+(?:/[^/]+){10}(?:/|$)).*$" }
    ] },
    "portablePath256": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9._/+,-])(?!/)(?![A-Za-z]:)(?!.*//)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/\\\\]*)?(?:/|$))(?!.*(?:^|/)[^/]{256}(?:/|$))[A-Za-z0-9][A-Za-z0-9._+,-]*(?:/[A-Za-z0-9][A-Za-z0-9._+,-]*)*$",
      "minLength": 1,
      "maxLength": 256
    },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,127}$", "minLength": 1, "maxLength": 128 },
    "defaultString": { "type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048 },
    "defaultString256": { "type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256 },
    "verifierString": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$", "minLength": 1, "maxLength": 128 },
    "pathComponent": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[^A-Za-z0-9._+,-])(?!.*[. ]$)(?!^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/\\\\]*)?$)[A-Za-z0-9][A-Za-z0-9._+,-]*$",
      "minLength": 1,
      "maxLength": 255
    },
    "acceptanceClass": { "enum": ["ordinary", "authority", "requirement", "resource-bounded", "concurrency", "evidence", "benchmark"] },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "environment", "argv"],
      "properties": {
        "id": { "$ref": "#/$defs/verifierString" },
        "version": { "$ref": "#/$defs/verifierString" },
        "environment": { "enum": ["local", "ci", "review", "external"] },
        "argv": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/defaultString256" } }
      }
    },
    "artifactName": { "type": "string", "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "bytes"],
      "properties": {
        "name": { "$ref": "#/$defs/artifactName" },
        "path": { "$ref": "#/$defs/artifactPath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "exit_status", "started_at", "completed_at", "artifacts"],
      "properties": {
        "verifier": { "$ref": "#/$defs/verifier" },
        "exit_status": { "const": 0 },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "planPublicationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptance_class", "requirement", "status", "specification"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "acceptance_class": { "$ref": "#/$defs/acceptanceClass" },
        "requirement": { "$ref": "#/$defs/defaultString" },
        "status": { "const": "specified" },
        "specification": { "$ref": "#/$defs/evidence" }
      }
    },
    "implementationObservedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptance_class", "requirement", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "acceptance_class": { "$ref": "#/$defs/acceptanceClass" },
        "requirement": { "$ref": "#/$defs/defaultString" },
        "status": { "const": "observed" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "blocked_by"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 1, "maxLength": 64 },
        "reason": { "$ref": "#/$defs/defaultString" },
        "blocked_by": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] }
      }
    },
    "implementationBlockedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptance_class", "requirement", "status", "blocker"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "acceptance_class": { "$ref": "#/$defs/acceptanceClass" },
        "requirement": { "$ref": "#/$defs/defaultString" },
        "status": { "const": "blocked" },
        "blocker": { "$ref": "#/$defs/blocker" }
      }
    },
    "row": {
      "oneOf": [
        { "$ref": "#/$defs/planPublicationRow" },
        { "$ref": "#/$defs/implementationObservedRow" },
        { "$ref": "#/$defs/implementationBlockedRow" }
      ]
    }
  },
  "x-portable-path-corpus": [
    { "value": "a", "valid": true },
    { "value": "dir/file.txt", "valid": true },
    { "value": "dir/.hidden", "valid": false },
    { "value": "_hidden/file", "valid": false },
    { "value": "dir/-leading", "valid": false },
    { "value": "dir/name-", "valid": true },
    { "value": "dir/report.", "valid": false },
    { "value": "dir/report ", "valid": false },
    { "value": "CON/file", "valid": false },
    { "value": "dir/CON.txt", "valid": false },
    { "value": "dir/COM1.log", "valid": false },
    { "value": "dir/clock$.txt", "valid": false },
    { "value": "dir//file", "valid": false },
    { "value": "../file", "valid": false },
    { "value": "dir/./file", "valid": false },
    { "value": "dir\\file", "valid": false },
    { "value": "dir%2Ffile", "valid": false },
    { "value": "dir:file", "valid": false },
    { "value": "/file", "valid": false },
    { "value": "C:file", "valid": false },
    { "value": "a/b/c/d/e/f/g/h/i/j", "valid": true },
    { "value": "a/b/c/d/e/f/g/h/i/j/k", "valid": false },
    { "value": "é/file", "valid": false },
    { "value": "file\n", "valid": false },
    { "value": "a/", "valid": false },
    { "value": "a/b_c+,-.txt", "valid": true }
  ],
  "x-artifact-name-corpus": [
    { "value": "é", "valid": true },
    { "value": "name with spaces", "valid": true },
    { "value": "logical/name", "valid": true },
    { "value": "é", "repeat": 64, "valid": true },
    { "value": "é", "repeat": 64, "suffix": "a", "valid": false },
    { "value": "", "valid": false },
    { "value": "name\u0007", "valid": false },
    { "encoding": "invalid-utf8", "bytes_hex": "ff", "valid": false },
    { "values": ["duplicate", "duplicate"], "kind": "duplicate", "valid": false },
    { "values": ["CaseName", "casename"], "kind": "identity-case", "platform": "windows", "valid": false }
  ],
  "allOf": [
    {
      "if": { "properties": { "evaluation_scope": { "const": "plan-publication" } } },
      "then": { "properties": { "rows": { "items": { "$ref": "#/$defs/planPublicationRow" } } } }
    },
    {
      "if": { "properties": { "evaluation_scope": { "const": "implementation-delivery" } } },
      "then": { "properties": { "rows": { "items": { "oneOf": [{ "$ref": "#/$defs/implementationObservedRow" }, { "$ref": "#/$defs/implementationBlockedRow" }] } } } }
    }
  ]
}
