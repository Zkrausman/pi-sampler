{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-sampler.dev/delivery-evidence/acceptance-manifest-v1.schema.json",
  "title": "Delivery acceptance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticket_id", "repository", "plan_path", "plan_sha256", "base_sha", "rows"],
  "properties": {
    "schema_version": {"const": "acceptance-manifest/v1"},
    "ticket_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$", "maxLength": 64},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "plan_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.md$", "maxLength": 240},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "acceptance_class", "requirement"],
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]{1,9}-T[0-9]{2,4}$", "maxLength": 32},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "acceptance_class": {"type": "string", "enum": ["ordinary", "authority", "waiver", "requirement", "benchmark-local-10m", "benchmark-ci-regression", "resource-bounded", "concurrency"]},
          "requirement": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  }
}
