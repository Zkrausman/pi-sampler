{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project immutable external evidence reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "sha256", "content_classification"],
  "properties": {
    "schema_version": {"const": "evidence-reference/v1"},
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_classification": {"enum": ["raw_external", "redacted_external"]},
    "redaction_status": {"enum": ["not_applicable", "redacted", "pending_review"]}
  }
}
